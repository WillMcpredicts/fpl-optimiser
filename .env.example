# Variable NAMES only - no values. Copy to .env.local for local dev.

# ---- Supabase ----
# Public: used by the Next.js app for read-only queries. RLS is not relied on
# here (single-user tool behind a password gate), so the anon key is only ever
# given SELECT on the read models.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used by the Python ingestion and by server-side
# route handlers. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Single shared password for the gate (section 1: personal-use tool).
APP_PASSWORD=
# Random string used to sign the auth cookie.
AUTH_SECRET=

# ---- FPL ----
# Your FPL manager id, used for squad import from GW2 onwards.
FPL_MANAGER_ID=
